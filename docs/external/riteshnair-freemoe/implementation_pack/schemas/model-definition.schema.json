{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeMoe Model Definition Draft",
  "type": "object",
  "required": [
    "schema_version",
    "model_id",
    "architecture",
    "tensors",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "type": "object",
      "required": [
        "family",
        "inputs",
        "outputs"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "tensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "shape",
          "dtype",
          "trainable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "dtype": {
            "enum": [
              "F32",
              "I32"
            ]
          },
          "trainable": {
            "type": "boolean"
          },
          "initialisation": {
            "type": "string"
          },
          "storage": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "inputs",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "op": {
            "enum": [
              "linear",
              "relu",
              "tanh",
              "mse_loss"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attributes": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "training": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}