# Five exploratory repetitions. OS cache state is not controlled: runs are
# labelled process-cold, not OS-cold. See docs/BENCHMARK_PROTOCOL.md.
RUN_ID=synthetic-moe-buffered
MODEL=tests/fixtures/moe-fm.gguf
BACKEND=cpu
READER=buffered
CACHE_SLOTS=1
TOKENS=16
LIMIT=20
PREFETCH=0
REFERENCE_ROOT=tests/reference
R=5
TARGET_P95_MS=50
MIN_PREFILL_TPS=1000
# Pin the target width. `auto` would be identical, but stating it makes the
# protocol explicit: the deployment target is Zen 3 (dual 256-bit AVX2 + FMA3,
# no AVX-512), so benchmark numbers must come from the AVX2 path.
EXTRA_ARGS="--kernels zen3"
