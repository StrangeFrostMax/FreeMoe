# Build outputs
/build/
*.o
*.a
*.so
*.so.*
/bin/
/lib/
/third_party/vnpu/build/
/third_party/vnpu/bin/
/third_party/vnpu/lib/
/third_party/vnpu/benchmarks/

# Generated run data (regenerate and archive deliberately)
/results/
/traces/
/tests/**/results/
/tests/**/traces/

# Python
__pycache__/
*.py[cod]

# Sanitizer and editor files
*.log
# Phase 0 evidence logs are release artefacts and must remain tracked.
!docs/evidence/*.log
*.profraw
*.dSYM/
.vscode/
.idea/

# Downloaded model weights are never committed. Only the small synthetic
# conformance fixtures are tracked; real checkpoints stay wherever you keep
# them (including any Google Drive download directory).
google_drive/
models/
*.gguf
!tests/fixtures/*.gguf
!tests/malformed_models/*.gguf
